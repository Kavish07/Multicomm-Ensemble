# Any subset of providers works; missing ones are skipped and weights renormalise.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# Optional overrides
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-sonnet-4-6
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
QWEN_MODEL=qwen2.5-coder-32b-instruct
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Force mock mode even with keys present (0/1)
MULTICOMM_MOCK=
# Weight source: wif | static | weightnet   (default: wif)
WEIGHT_SOURCE=wif
